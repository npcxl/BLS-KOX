# ============================================================
# BLS-KOX 生产环境变量模板 —— 服务器 47.94.205.207
# 目标位置：/opt/bls-kox/.env.docker      （chmod 600，勿入库）
#
#   cp deploy/server/env.docker.production.example /opt/bls-kox/.env.docker
#   然后把所有 <...> 替换成真实值
#
# 本机密约：MySQL / Redis 是【外部服务】(117.72.118.165)，
# 本机只跑 bls-server 一个容器，不要起 mysql / redis 容器。
#
# 校验方式（唯一可信）：docker compose --env-file .env.docker \
#   -f docker-compose.yml -f docker-compose.server-only.yml config | grep <变量名>
# 注意：写在 .env.docker 里但 compose 没透传的变量，容器里拿不到（见 bls-memory/00-common/00-architecture.md）。
# ============================================================

# ---------------- 数据库（外部，不要改成 mysql） ----------------
DB_HOST=117.72.118.165
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<117.72.118.165 的 MySQL 密码>
DB_NAME=kox

# ---------------- Redis（外部，不要改成 redis） ----------------
REDIS_HOST=117.72.118.165
REDIS_PORT=6379
REDIS_PASSWORD=<117.72.118.165 的 Redis 密码>
REDIS_ENABLED=true
# 与本地开发共用同一个 Redis 实例 → 必须换前缀，否则会话/限流/防重放/验证码票据的键直接撞车
REDIS_KEY_PREFIX=blsprod:

# ---------------- 生产必填（缺失/占位符/过短 → 容器启动即失败） ----------------
# 生成命令见每行注释；生产环境下 env.ts 会强校验，别用 CHANGE_TO_* 或 demo 值
JWT_SECRET=<openssl rand -hex 32>
INTERNAL_SECRET=<openssl rand -hex 32>
API_SIGN_SECRET=<openssl rand -base64 32>
# ALTCHA 隐形验证码的签名密钥，最少 32 字符
ALTCHA_HMAC_KEY=<openssl rand -hex 24>
# ★ 必须 base64 且解码后正好 32 字节
# 因为本库与本地开发【共用】，若库里已有 enc:v1:v1:* 密文，这里必须填「dev 从 JWT_SECRET
# 用 HKDF 派生出的那个值」（salt=bls-kox-secret-envelope, info=secret-encryption, 32B），
# 否则旧密文（storage 密钥 / api key / webhook secret / ai model key）全部解不开。
# 查有没有密文：
#   SELECT COUNT(*) FROM sys_storage_config WHERE access_key LIKE 'enc:%' OR secret_key LIKE 'enc:%';
# 派生命令（在本地跑，用本地 bls-server/.env 的 JWT_SECRET）：
#   node -e "const{hkdfSync}=require('crypto');console.log(Buffer.from(hkdfSync('sha256',Buffer.from(process.argv[1],'utf8'),Buffer.from('bls-kox-secret-envelope','utf8'),Buffer.from('secret-encryption','utf8'),32)).toString('base64'))" "<本地JWT_SECRET>"
SECRET_ENCRYPTION_KEY=<必填：新库用 openssl rand -base64 32；共库有历史密文时用上面派生出的值>
SECRET_ENCRYPTION_KEY_VERSION=v1

# ---------------- 站点域名（生产强校验：非空、且不能含 *） ----------------
CORS_ORIGINS=https://admin.xlcig.cn,https://api.xlcig.cn

# ---------------- MinIO：当前不部署 ----------------
# 这里只是为了满足 compose 的 ${MINIO_USER:?} 插值（compose 会校验整个文件，
# 即使你只 up bls-server）。等真要开文件上传时，这两个值就是真实账号，需同步改
# sys_storage_config 的种子数据。
MINIO_USER=blsminio
MINIO_PASSWORD=<强随机，建议 openssl rand -base64 24 | tr -d '/+='>

# ---------------- AI 微服务（bls-ai-service）----------------
# AI_SERVICE_URL 只用于 bls-server 的启动自检；留空 = 视为未部署 → 自检显示 [SKIP]
# 容器里的 127.0.0.1 指的是容器自己，所以必须写服务名，写本机地址一定是 [FAIL]。
AI_SERVICE_URL=http://bls-ai-service:7201
# 下面这组是【AI 服务容器】读取的（base 的 environment 白名单里有，写这里是有效的）
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_MODEL_OPTIONS=deepseek-chat,deepseek-reasoner
AI_BASE_URL=https://api.deepseek.com/v1
# 必填；生产环境会拒绝 CHANGE_TO_* 占位符
OPENAI_API_KEY=<DeepSeek / OpenAI 的 key>
# AI 服务自己的 Redis 前缀（与 bls-server 的 blsprod: 区分开，避免共用实例时撞键）
AI_REDIS_KEY_PREFIX=blsprod-ai:

# ---------------- 第二层人机验证（tianai-captcha，Java）----------------
# 路径默认值 /captcha/generate、/captcha/verify、/health 已与 bls-captcha-service 对齐，
# 一般不用覆盖；上游路径不同时才用 TIANAI_GENERATE_PATH / TIANAI_VERIFY_PATH / TIANAI_HEALTH_PATH。
# ⚠ fail closed：若 sys_config.captcha_tianai_enabled=true 而本服务不可用，
#   超管 / 连续失败账号会直接登不进去（50302）。必须先部署服务、再打开开关。
TIANAI_BASE_URL=http://tianai-captcha:8083

# ---------------- 未部署的可选服务：一律留空 ----------------
# 留空 → 启动自检显示 [SKIP]（功能降级），而不是 [FAIL]（故障）。
# 事件服务（审计事件 / outbox 投递）：要用时部署 bls-event-service 并填 http://bls-event-service:7101
EVENT_SERVICE_URL=
# ⚠ Tianai 是 fail-closed：库里 captcha_tianai_enabled=true 而服务不可用 → 超管/高风险账号
#   登录直接 50302。本库与开发共用，所以要先确认：
#   SELECT tenant_id, config_key, config_value FROM sys_config WHERE config_key LIKE '%captcha%' AND deleted=0;
