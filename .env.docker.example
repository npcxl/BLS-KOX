# ============================================================
# BLS-KOX 服务器部署 docker-compose 环境变量
# 此文件位于服务器 ${DEPLOY_PATH}/.env.docker
# 由 CNB 流水线通过 imports 注入运行时变量
# ============================================================

# 数据库
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME:-bls}

# JWT 配置
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO 对象存储（生产环境必须修改）
MINIO_USER=${MINIO_USER}
MINIO_PASSWORD=${MINIO_PASSWORD}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# 内部服务认证
INTERNAL_SECRET=${INTERNAL_SECRET}

# CORS（生产环境必须设置实际域名）
CORS_ORIGINS=${CORS_ORIGINS:-https://your-domain.com}

# API 签名密钥
API_SIGN_SECRET=${API_SIGN_SECRET:-}

# 事件服务地址
EVENT_SERVICE_URL=${EVENT_SERVICE_URL:-}

# AI 服务
AI_PROVIDER=${AI_PROVIDER:-deepseek}
AI_MODEL=${AI_MODEL:-deepseek-chat}
OPENAI_API_KEY=${OPENAI_API_KEY}

# ====== 发布中心 (ops-release) ======
# GitHub 配置
GITHUB_OWNER=${GITHUB_OWNER:-npcxl}
GITHUB_REPO=${GITHUB_REPO:-BLS-KOX}
GITHUB_DEPLOY_WORKFLOW=${GITHUB_DEPLOY_WORKFLOW:-deploy-production.yml}
GITHUB_DEPLOY_REF=${GITHUB_DEPLOY_REF:-main}
GITHUB_DEPLOY_TOKEN=${GITHUB_DEPLOY_TOKEN}
# 回调安全
RELEASE_CALLBACK_SECRET=${RELEASE_CALLBACK_SECRET}
RELEASE_CALLBACK_URL=${RELEASE_CALLBACK_URL:-}
