# ============================================================
# BLS-KOX 生产环境配置模板
# 复制为 .env.production 并填入真实值
# ============================================================

# 应用版本（由 deploy.sh 自动更新）
APP_VERSION=1.0.0

# HTTP 端口
HTTP_PORT=8088

# 数据库
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=kox

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS

# 内部服务认证
INTERNAL_SECRET=CHANGE_ME

# API 签名
API_SIGN_SECRET=CHANGE_ME

# AI 服务
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
OPENAI_API_KEY=CHANGE_ME
AI_BASE_URL=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# CORS
CORS_ORIGINS=https://your-domain.com

# 事件服务（可选）
EVENT_SERVICE_URL=
