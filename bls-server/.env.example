NODE_ENV=development
APP_PORT=6001
APP_NAME=bls-server

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=bls
DB_CONNECTION_LIMIT=10

JWT_SECRET=please_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:9000

#可信代理（Nginx 前置时开启，Koa 信任 X-Forwarded-* Header）
TRUST_PROXY=false

#Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=123456

#防重放攻击配置
REPLAY_ENABLED=true
#API_SIGN_SECRET=your-hmac-secret-here（签名模式需要，浏览器前端不设置）
#REPLAY_WINDOW_SECONDS=120
#REPLAY_NONCE_TTL_SECONDS=180
#REPLAY_DEFAULT_MODE=nonce
#REPLAY_PROTECTED_METHODS=POST,PUT,PATCH,DELETE

#客户端 IP 解析：只有在拿不到客户端 IP（本地回环直连）时才会去公网接口查出口 IP。
#无外网 / 内网部署建议显式配置，可彻底避免这次公网请求（否则解析最多多花 ~2s）。
#PUBLIC_IP=1.2.3.4

#登录人机验证（ALTCHA，自托管开源库 https://github.com/altcha-org/altcha）
#生产环境必填：>=32 位强随机串，用于签名 / 校验 ALTCHA challenge
#ALTCHA_HMAC_KEY=please_change_to_a_random_string_at_least_32_chars
#Proof-of-Work 难度（PBKDF2 迭代次数），默认 50000，仅服务端使用
#ALTCHA_COST=50000
#可选：provider=tianai 时使用的独立验证码服务地址（Koa 仅做代理，不实现算法）
#TIANAI_BASE_URL=
#仅开发环境可开启（生产环境开启会导致进程拒绝启动）
#CAPTCHA_DEV_BYPASS=false