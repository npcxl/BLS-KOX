NODE_ENV=development
APP_PORT=6001
APP_NAME=bls-server

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=bls
DB_CONNECTION_LIMIT=10

JWT_SECRET=please_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:9000

#可信代理（Nginx 前置时开启，Koa 信任 X-Forwarded-* Header）
TRUST_PROXY=false

#Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=123456
#关闭 Redis 会让会话、防重放、限流、幂等全部失效（生产环境禁止关闭）
#REDIS_ENABLED=true

#依赖自检：启动时检查所有微服务（实现见 src/observability/service-health.ts）
# 启动日志会打印一份 [ OK ]/[FAIL]/[SKIP] 报告；运行期可查 GET /api/ready（只回状态）、
# GET /internal/services（内部鉴权，含地址与启动命令）；命令行可用 npm run services:check。
#核心依赖（MySQL/Redis）不可用时是否拒绝启动：生产默认 true，开发默认 false
#SERVICE_CHECK_STRICT=true
#单个依赖探测超时（毫秒）
#SERVICE_CHECK_TIMEOUT_MS=3000
#运行期巡检间隔（毫秒，0 = 关闭）；仅在依赖下线/恢复的瞬间记日志
#SERVICE_CHECK_INTERVAL_MS=60000

#内部服务认证 Token（event-service 等内部服务调用时使用）
#INTERNAL_SECRET=change_me_internal_secret

#事件/审计微服务（bls-event-service，默认 7101）；不配置则跳过该依赖自检，
#但审计事件会留在 outbox（不再推送）
#EVENT_SERVICE_URL=http://127.0.0.1:7101

#AI 微服务（bls-ai-service，默认 7201）：Koa 自身不调用它（前端 proxy 直连），
#这里仅供依赖自检；开发环境默认 http://127.0.0.1:7201，生产必须显式配置
#AI_SERVICE_URL=http://127.0.0.1:7201


#防重放攻击配置
REPLAY_ENABLED=true
#API_SIGN_SECRET=your-hmac-secret-here（签名模式需要，浏览器前端不设置）
#REPLAY_WINDOW_SECONDS=120
#REPLAY_NONCE_TTL_SECONDS=180
#REPLAY_DEFAULT_MODE=nonce
#REPLAY_PROTECTED_METHODS=POST,PUT,PATCH,DELETE

#客户端 IP 解析：只有在拿不到客户端 IP（本地回环直连）时才会去公网接口查出口 IP。
#无外网 / 内网部署建议显式配置，可彻底避免这次公网请求（否则解析最多多花 ~2s）。
#PUBLIC_IP=1.2.3.4

#第二层人机验证（Tianai CAPTCHA，独立部署的图形验证码服务）
#未配置时：策略一旦要求第二层，登录会 fail closed（503/50301）——请部署后再开启，或把
#sys.login.captcha.mode 设为 off。部署后可用下面的 curl 自检：
#  curl -s "$TIANAI_BASE_URL/health"
#  curl -s "$TIANAI_BASE_URL/gen?type=blockPuzzle"
#  curl -s -X POST "$TIANAI_BASE_URL/check" -H 'Content-Type: application/json' -d '{"id":"<id>","data":{"x":1,"y":1}}'
#TIANAI_BASE_URL=http://127.0.0.1:9527
#路径与上游不一致时用这三个覆盖（默认 /gen /check /health）
#TIANAI_GEN_PATH=/gen
#TIANAI_CHECK_PATH=/check
#TIANAI_HEALTH_PATH=/health

#登录人机验证（ALTCHA，自托管开源库 https://github.com/altcha-org/altcha）
#生产环境必填：>=32 位强随机串，用于签名 / 校验 ALTCHA challenge
#ALTCHA_HMAC_KEY=please_change_to_a_random_string_at_least_32_chars
#Proof-of-Work 难度（PBKDF2 迭代次数），默认 50000，仅服务端使用
#ALTCHA_COST=50000
#可选：provider=tianai 时使用的独立验证码服务地址（Koa 仅做代理，不实现算法）
#TIANAI_BASE_URL=
#仅开发环境可开启（生产环境开启会导致进程拒绝启动）
#CAPTCHA_DEV_BYPASS=false