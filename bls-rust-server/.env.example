APP_HOST=0.0.0.0
APP_PORT=6002
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:8000,http://localhost:9000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD
DB_NAME=bls
DB_CONNECTION_LIMIT=10

REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_TO_A_STRONG_REDIS_PASSWORD
REDIS_ENABLED=true
REDIS_KEY_PREFIX=bls:

JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REPLAY_ENABLED=true
API_SIGN_SECRET=CHANGE_TO_A_RANDOM_HMAC_SECRET
REPLAY_WINDOW_SECONDS=120
REPLAY_NONCE_TTL_SECONDS=180

INTERNAL_SECRET=CHANGE_TO_A_RANDOM_INTERNAL_SECRET
RELEASE_CALLBACK_SECRET=CHANGE_TO_A_RANDOM_RELEASE_CALLBACK_SECRET
EVENT_SERVICE_URL=
WS_ENABLED=true
UPLOAD_DIR=./uploads

# ====== AI 服务（OpenAI 兼容 Provider）======
# 支持 openai / deepseek / qwen / ollama 等，均为 OpenAI 兼容的 /chat/completions 接口
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
OPENAI_API_KEY=CHANGE_TO_YOUR_AI_API_KEY
# 留空则根据 AI_PROVIDER 自动推断默认 base_url；Ollama 本地模式填 http://ollama:11434/v1
AI_BASE_URL=
AI_TIMEOUT_MS=60000